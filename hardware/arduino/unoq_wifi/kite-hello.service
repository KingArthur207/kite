[Unit]
Description=Kite: UNO Q says hello on the network
Wants=network-online.target
After=network-online.target

[Service]
ExecStart=/usr/bin/python3 /home/arduino/kite/hello_sender.py
Environment=KITE_HELLO_MODE=cloud
Restart=always
RestartSec=2
User=arduino
# For direct UDP on a shared network instead: KITE_HELLO_MODE=udp (or both); KITE_HELLO_HOST=<ip> to send to one computer:
# Environment=KITE_HELLO_HOST=192.168.137.1

[Install]
WantedBy=multi-user.target
