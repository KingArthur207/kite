[Unit]
Description=Kite: UNO Q says hello on the network
Wants=network-online.target
After=network-online.target

[Service]
ExecStart=/usr/bin/python3 /home/arduino/kite/hello_sender.py
Restart=always
RestartSec=2
User=arduino
# Uncomment and set to send to one computer instead of broadcasting:
# Environment=KITE_HELLO_HOST=192.168.137.1

[Install]
WantedBy=multi-user.target
