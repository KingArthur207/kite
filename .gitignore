uv.lock

# Rust
target/

# Node
node_modules/
dist/

# OS / editors
.DS_Store
.idea/
.vscode/

# Local outputs
results/
earpiece/out/
earpiece/.cache/
.wrangler/
recordings/
data/models/

# Claude Code agent worktrees
.claude/worktrees/

# Stand-in detector weights stay local (sim/standin_detect.py --download)
weights/

# Stock clips and demo renders stay local (Pexels/Mixkit), never committed
clips/
out/

# scripts/demo.sh logs and pids
logs/

# Street View-derived facades, model and screenshots stay local, never committed or published
sim/public/local/

# Grok Imagine clips and rehearsal outputs (regenerate with scripts/imagine_scenes.py);
# the stills, manifest and rehearsal summaries are committed
data/imagined/*.mp4
data/imagined/*.wav
data/imagined/*.jsonl
phone/.state/

# phone-app: Expo generates the native folders (npx expo prebuild); commit the source only
phone-app/ios/
phone-app/android/
.expo/
