# Copy to .env and fill in. Never commit .env.

# Google Maps (Routes API v2 + Places API (New); legacy Directions/Places are NOT enabled on the key)
GOOGLE_MAPS_API_KEY=

# Claude: route + scene reasoning (console.anthropic.com)
ANTHROPIC_API_KEY=

# Gemini: drone video scene description (aistudio.google.com/apikey)
GEMINI_API_KEY=

# Cartesia: voice to AirPods (play.cartesia.ai)
CARTESIA_API_KEY=

# Moss: route/landmark memory retrieval (only if we enter the Moss track)
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=
