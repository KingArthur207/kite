# Copy to .env and fill in. Never commit .env.

# Google Maps (Routes API v2 + Places API (New); legacy Directions/Places are NOT enabled on the key)
GOOGLE_MAPS_API_KEY=

# Claude: route + scene reasoning (console.anthropic.com)
ANTHROPIC_API_KEY=

# Cartesia: voice to AirPods (play.cartesia.ai)
CARTESIA_API_KEY=

# Moss: route/landmark memory retrieval (only if we enter the Moss track)
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=

# Kite network (spec section 6, docs/network.md). Never hardcode hosts in code.
# Check it with: python3 scripts/netcheck.py
# Earpiece address for producers: 127.0.0.1 on one laptop, the wearable laptop's
# Thunderbolt bridge IP from the drone laptop (earpiece run with --bind 0.0.0.0).
KITE_EARPIECE_HOST=127.0.0.1
# SpacetimeDB: Maincloud by default; http://127.0.0.1:3000 for the offline fallback.
SPACETIME_HOST=https://maincloud.spacetimedb.com
SPACETIME_DB=kite-sync-pl6rp
