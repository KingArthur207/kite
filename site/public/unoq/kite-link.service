[Unit]
Description=Kite link: the UNO Q talks to the computer (text and video)
Wants=network-online.target
After=network-online.target

[Service]
# install.sh fills in __USER__ and __DIR__
# The UNO Q's USB-C port can boot in device mode, so a USB camera on a hub is never seen (a known UNO Q
# quirk). Force host mode before starting; harmless where the file doesn't exist. Runs as root ("+").
ExecStartPre=+/bin/sh -c 'mountpoint -q /sys/kernel/debug || mount -t debugfs none /sys/kernel/debug 2>/dev/null; f=/sys/kernel/debug/usb/4e00000.usb/mode; if [ -w "$$f" ]; then echo host > "$$f"; sleep 2; fi; true'
ExecStart=/usr/bin/python3 __DIR__/board.py
User=__USER__
SupplementaryGroups=video
Environment=PYTHONUNBUFFERED=1
Environment=KITE_SOURCE=unoq
Environment=KITE_PORT=8765
Environment=KITE_CAMERA=auto
Environment=KITE_VIDEO_SIZE=640x480
Environment=KITE_VIDEO_FPS=10
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
