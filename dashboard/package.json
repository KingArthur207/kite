{
  "name": "kite-sync",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check": "node --experimental-strip-types --no-warnings src/timeline.check.ts && node --experimental-strip-types --no-warnings src/view.check.ts && node --experimental-strip-types --no-warnings src/clients.check.ts",
    "preview": "vite preview",
    "spacetime:generate": "spacetime generate --lang typescript --out-dir src/module_bindings --module-path spacetimedb -y",
    "spacetime:publish": "spacetime publish --module-path spacetimedb --server maincloud kite-sync-pl6rp -y",
    "spacetime:publish:local": "spacetime publish --module-path spacetimedb --server local kite-sync-pl6rp -y"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "spacetimedb": "2.13.*"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "~5.6.2",
    "vite": "^7.1.5"
  }
}
