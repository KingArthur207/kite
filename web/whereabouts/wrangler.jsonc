{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kite-whereabouts",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-24",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
